{
  "name": "compra-facil-app",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "indexmjs": "node .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "nuxi typecheck",
    "lint:fix": "eslint . --fix",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "test:watch": "TSX_TSCONFIG_PATH=tests/tsconfig.json tsx watch --ignore .nuxt --ignore .output --test --experimental-test-isolation=none tests/*.test.ts",
    "test:integration": "TSX_TSCONFIG_PATH=tests/tsconfig.json node --import tsx --test --experimental-test-isolation=none tests/integration/*.test.ts",
    "db:seed": "tsx server/database/seeds/run.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/types": "^2.18.1",
    "@nuxt/typescript-build": "^3.0.2",
    "@nuxtjs/leaflet": "^1.3.2",
    "@pinia/nuxt": "0.11.0",
    "@types/html2pdf.js": "^0.10.0",
    "@vercel/functions": "3.4.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "html2pdf.js": "^0.12.0",
    "lodash-es": "^4.17.21",
    "maska": "^3.1.1",
    "nominatim-browser": "^2.1.0",
    "nuxt": "^3.14.1592",
    "pg": "^8.23.0",
    "pinia": "^3.0.2",
    "vue": "latest",
    "vue-router": "latest",
    "vuetify-nuxt-module": "^0.18.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@nuxt/eslint": "1.9.0",
    "@types/bcrypt": "^5.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-tsc": "3.1.1"
  },
  "resolutions": {
    "vue-eslint-parser": "10.2.0",
    "@eslint/config-inspector": "1.4.2",
    "eslint-config-flat-gitignore": "2.1.0",
    "@typescript-eslint/parser": "8.46.1",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/utils": "8.46.1",
    "@typescript-eslint/type-utils": "8.46.1",
    "eslint-plugin-vue": "10.4.0"
  }
}
