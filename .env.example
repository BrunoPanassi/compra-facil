# Persistence strategy (PostgreSQL remains disabled in this stage)
PRIVATE_USE_SQL=false
PRIVATE_USE_JSONBIN=true

# Local PostgreSQL
POSTGRES_DB=compra_facil
POSTGRES_USER=compra_facil
POSTGRES_PASSWORD=compra_facil
POSTGRES_PORT=5432
DATABASE_URL=postgresql://compra_facil:compra_facil@localhost:5432/compra_facil
NUXT_DATABASE_URL=postgresql://compra_facil:compra_facil@localhost:5432/compra_facil
DATABASE_DIRECT_URL=

# Maps
PRIVATE_USE_GOOGLEMAPS_SEARCH_ADDRESS=false
PRIVATE_USE_OPENSTREETMAP_SEARCH_ADDRESS=true
PRIVATE_USE_PHOTON_SEARCH_ADDRESS=false
PRIVATE_OPENSTREETMAP_URL=
PRIVATE_PHOTON_URL=
PRIVATE_GOOGLEMAPS_URL=
PRIVATE_USE_LEAFLET_UI=true

# JSONBin (use non-secret development values)
JSONBIN_API_KEY=
JSONBIN_BASE_URL=
JSONBIN_USERS_ID=
JSONBIN_STORES_ID=
JSONBIN_PRODUCTS_ID=
JSONBIN_MATERIALS_ID=
JSONBIN_MATERIAL_TYPES_ID=
JSONBIN_PRODUCT_STORES_ID=

# Image hosting
IMAGE_HOSTING_API_KEY=
IMAGE_HOSTING_BASE_URL=
