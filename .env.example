# Persistence strategy (NUXT_USE_SQL takes precedence when both are set)
NUXT_USE_SQL=false
PRIVATE_USE_SQL=false

# Local PostgreSQL
POSTGRES_DB=compra_facil
POSTGRES_USER=compra_facil
POSTGRES_PASSWORD=<local-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_DIRECT_URL=

# Maps
PRIVATE_USE_GOOGLEMAPS_SEARCH_ADDRESS=false
PRIVATE_USE_OPENSTREETMAP_SEARCH_ADDRESS=true
PRIVATE_USE_PHOTON_SEARCH_ADDRESS=false
PRIVATE_OPENSTREETMAP_URL=
PRIVATE_PHOTON_URL=
PRIVATE_GOOGLEMAPS_URL=
PRIVATE_USE_LEAFLET_UI=true

# JSONBin (use non-secret development values)
JSONBIN_API_KEY=
JSONBIN_BASE_URL=
JSONBIN_USERS_ID=
JSONBIN_STORES_ID=
JSONBIN_PRODUCTS_ID=
JSONBIN_MATERIALS_ID=
JSONBIN_MATERIAL_TYPES_ID=
JSONBIN_PRODUCT_STORES_ID=

# Image hosting
IMAGE_HOSTING_API_KEY=
IMAGE_HOSTING_BASE_URL=
IMAGE_HOSTING_UPLOAD_URL=

# Private server-only settings; DATABASE_URL takes precedence over legacy NUXT_DATABASE_URL.
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# true verifies TLS certificates; false leaves SSL options to the connection string.
DATABASE_SSL=false
DATABASE_SSL_CA=
# Explicitly set development for the guarded local seed; production for local preview.
NODE_ENV=development
